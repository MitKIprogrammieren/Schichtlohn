map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Startseite = nur das Lager (für den Seitenleisten-Eintrag in Bambuddy)
    location = / {
        return 302 /index.html?ansicht=lager;
    }

    # SchichtLohn in den Bambuddy-Modus schalten
    location = /index.html {
        sub_filter '<!--SL_BAMBUDDY-->' '<script>window.SL_BAMBUDDY={api:"/api/v1"}</script>';
        sub_filter_once on;
        add_header Cache-Control "no-cache";
    }

    # Bambuddy-API und WebSocket über dieselbe Adresse
    location /api/ {
        proxy_pass ${BAMBUDDY_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-API-Key "${BAMBUDDY_API_KEY}";
        proxy_read_timeout 3600s;
        client_max_body_size 20m;
    }

    # Nicht ausliefern: Cloudflare-Functions, Git-Daten, dieser Ordner
    location ^~ /functions/ { deny all; }
    location ~ /\.git      { deny all; }
    location = /bambuddy/adapter.js { add_header Cache-Control "no-cache"; }
    location ^~ /bambuddy/  { deny all; }
}
